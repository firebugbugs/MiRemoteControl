<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MiRemoteControl</AssemblyName>
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <ApplicationIcon>Assets\head_portrait.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Plugin projects stage plugin.json/icon.png via ProjectReference; publish
         only needs their zipped bundles from StageDesktopWindowsRuntime, so the
         colliding loose copies must not fail self-contained publish. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MiRemoteControl.Client/MiRemoteControl.Client.csproj" />
    <ProjectReference Include="../MiRemoteControl.Contracts/MiRemoteControl.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Rc003HidTap.js" />
    <EmbeddedResource Include="Infrastructure\Assets\frida-gadget-17.15.3-windows-x86_64.dll.xz" />
  </ItemGroup>
  <!-- F5 must run the Host and plugins from the same build as Desktop,
       rather than silently falling back to a previously packaged release. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="../MiRemoteControl.Host/MiRemoteControl.Host.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../../plugins/MiRemoteControl.Plugin.ChatGpt/MiRemoteControl.Plugin.ChatGpt.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../../plugins/MiRemoteControl.Plugin.Reasonix/MiRemoteControl.Plugin.Reasonix.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../../plugins/MiRemoteControl.Plugin.ZCode/MiRemoteControl.Plugin.ZCode.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../../plugins/MiRemoteControl.Plugin.XiaomiRemote/MiRemoteControl.Plugin.XiaomiRemote.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="StageDesktopWindowsRuntime" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_WindowsRuntimeFramework>net10.0-windows10.0.19041.0</_WindowsRuntimeFramework>
      <_HostOutput>$(MSBuildProjectDirectory)/../MiRemoteControl.Host/bin/$(Configuration)/$(_WindowsRuntimeFramework)/</_HostOutput>
      <_PluginsOutput>$(MSBuildProjectDirectory)/../../plugins</_PluginsOutput>
    </PropertyGroup>
    <ItemGroup>
      <_HostRuntimeFiles Include="$(_HostOutput)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HostRuntimeFiles)"
          DestinationFiles="@(_HostRuntimeFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)plugins/targets;$(OutDir)plugins/remotes" />
    <ZipDirectory SourceDirectory="$(_PluginsOutput)/MiRemoteControl.Plugin.ChatGpt/bin/$(Configuration)/$(_WindowsRuntimeFramework)"
                  DestinationFile="$(OutDir)plugins/targets/mrc.chatgpt.mrcplugin" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(_PluginsOutput)/MiRemoteControl.Plugin.Reasonix/bin/$(Configuration)/$(_WindowsRuntimeFramework)"
                  DestinationFile="$(OutDir)plugins/targets/mrc.reasonix.mrcplugin" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(_PluginsOutput)/MiRemoteControl.Plugin.ZCode/bin/$(Configuration)/$(_WindowsRuntimeFramework)"
                  DestinationFile="$(OutDir)plugins/targets/mrc.zcode.mrcplugin" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(_PluginsOutput)/MiRemoteControl.Plugin.XiaomiRemote/bin/$(Configuration)/$(_WindowsRuntimeFramework)"
                  DestinationFile="$(OutDir)plugins/remotes/mrc.remote.xiaomi.mrcplugin" Overwrite="true" />
  </Target>
</Project>

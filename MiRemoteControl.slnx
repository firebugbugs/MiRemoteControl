    <Project Path="src/MiRemoteControl.Client/MiRemoteControl.Client.csproj" />
    <Project Path="src/MiRemoteControl.Contracts/MiRemoteControl.Contracts.csproj" />
    <Project Path="src/MiRemoteControl.Core/MiRemoteControl.Core.csproj" />
    <Project Path="src/MiRemoteControl.Desktop/MiRemoteControl.Desktop.csproj" />
